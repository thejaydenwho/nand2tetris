// File name: projects/1/Mux.hdl
/** 
 * Multiplexor:
 * if (sel = 0) out = a, else out = b
 */
CHIP Mux {
    IN a, b, sel;
    OUT out;

    PARTS:
    And(a=sel, b=b, out=case1);
    Not(in=sel, out=notsel);
    And(a=a, b=notsel, out=case2);
    Or(a=case1, b=case2, out=out);
}